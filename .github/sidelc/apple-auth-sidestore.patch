+// BEGIN APPLE ANISETTE LOGIN POLICY
+// Authentication identity is independent from developer signing certificates.
+enum AppleAnisetteLoginPolicy {
+    static let migrationKey = "AppleLogin.macADI.v1"
+    static let identityKey = "AppleLogin.remoteIdentity"
+    static let macClientInfo = "<Mac15,7> <macOS;27.0;26A5378j> <com.apple.AuthKit/1 (com.apple.akd/1.0)>"
+    static let macUserAgent = "AuthKit/1 (Macintosh; OS X 27.0) (com.apple.akd/1.0)"
+
+    struct Identity: Equatable {
+        let clientInfo: String
+        let userAgent: String
+        func cacheKey(server: URL) -> String {
+            server.absoluteString.trimmingCharacters(in: CharacterSet(charactersIn: "/")).lowercased() + "|" + clientInfo + "|" + userAgent
+        }
     }
+    enum IdentityError: LocalizedError {
+        case unsupportedServerIdentity
+        var errorDescription: String? { "This Anisette server did not advertise a Mac identity. Choose a Mac ADI server." }
+    }
+    static func identity(clientInfo: String, userAgent: String) throws -> Identity {
+        let info = clientInfo.trimmingCharacters(in: .whitespacesAndNewlines)
+        let lower = info.lowercased()
+        guard lower.contains("mac"), !lower.contains("windows"), !lower.contains("android") else {
+            throw IdentityError.unsupportedServerIdentity
+        }
+        let pattern = "(?:Mac OS X|macOS);(\\d+)\\.(\\d+)"
+        let regex = try NSRegularExpression(pattern: pattern, options: .caseInsensitive)
+        if let match = regex.firstMatch(in: info, range: NSRange(info.startIndex..., in: info)),
+           let majorRange = Range(match.range(at: 1), in: info), let minorRange = Range(match.range(at: 2), in: info),
+           let major = Int(info[majorRange]), let minor = Int(info[minorRange]), major == 10, minor < 13 {
+            return Identity(clientInfo: macClientInfo, userAgent: macUserAgent)
+        }
+        let agent = userAgent.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !agent.lowercased().contains("windows"), !agent.lowercased().contains("android") else {
+            throw IdentityError.unsupportedServerIdentity
+        }
+        return Identity(clientInfo: info, userAgent: agent.isEmpty ? macUserAgent : agent)
+    }
+    static func isLegacyIdentity(_ info: String) -> Bool {
+        let lower = info.lowercased()
+        return lower.contains("windows") || lower.contains("android") || lower.contains("pixel") || lower.contains("dt.xcode")
+    }
 }
+// END APPLE ANISETTE LOGIN POLICY

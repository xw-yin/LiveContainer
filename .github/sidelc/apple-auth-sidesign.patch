+    // Retries the original request verbatim. Rebuilding a 2FA request here
+    // would lose security-code / JSON headers and could change client identity.
+    private func performLoginRequest(_ request: URLRequest) async throws -> (Data, URLResponse) {
+        var attempt = 0
+        while true {
+            try Task.checkCancellation()
+            let result = try await session.data(for: request)
+            let http = result.1 as? HTTPURLResponse
+            guard let delay = AppleLoginRequestPolicy.retryDelay(
+                statusCode: http?.statusCode ?? 0, attempt: attempt,
+                retryAfter: http?.value(forHTTPHeaderField: "Retry-After")) else { return result }
+            debugLog("[AppleLogin] Transient HTTP \(http?.statusCode ?? 0); retry \(attempt + 1) with the same request identity")
+            try await Task.sleep(nanoseconds: delay)
+            attempt += 1
+        }
+    }
+
     private func parsePlistOrJSON(_ data: Data) -> [String: any Sendable]? {
            (try? PropertyListSerialization.propertyList(from: data, format: nil)) as? [String: any Sendable]
         ?? (try? JSONSerialization.jsonObject(with: data, options: [])) as? [String: any Sendable]
     }
 }
+
+// BEGIN APPLE LOGIN REQUEST POLICY
+enum AppleLoginRequestPolicy {
+    static func retryDelay(statusCode: Int, attempt: Int, retryAfter: String?) -> UInt64? {
+        guard statusCode == 429 || statusCode == 503, (0..<2).contains(attempt) else { return nil }
+        if let text = retryAfter, !text.isEmpty {
+            // Unknown/date-based or long throttles are reported rather than
+            // retried earlier than the server permits.
+            guard let seconds = Double(text), seconds.isFinite, (0...15).contains(seconds) else { return nil }
+            return UInt64(seconds * 1_000_000_000)
+        }
+        return [2_000_000_000, 5_000_000_000][attempt]
+    }
+}
+// END APPLE LOGIN REQUEST POLICY
